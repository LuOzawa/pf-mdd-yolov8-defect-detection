# 默认：文本文件在仓库中统一使用 LF
* text=auto eol=lf

*.py     text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.json   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.cfg    text eol=lf

# Windows 脚本保留 CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# 二进制
*.pt     binary
*.pth    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.7z     binary
*.zip    binary
